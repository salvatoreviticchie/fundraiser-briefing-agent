<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Add_Overdue_Task</name>
        <label>Add Overdue Task</label>
        <locationX>132</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>openTasksSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SummaryPlusOverdueTask</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>overdueTaskCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>openTaskCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Each_Open_Task</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Open_Task</name>
        <label>Add Open Task</label>
        <locationX>396</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>openTasksSummary</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SummaryPlusOpenTask</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>openTaskCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Each_Open_Task</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Last_Engagement</name>
        <label>Set Last Engagement</label>
        <locationX>44</locationX>
        <locationY>866</locationY>
        <assignmentItems>
            <assignToReference>lastEngagementSubject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Last_Engagement.Subject</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>lastEngagementDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Last_Engagement.ActivityDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Is_Overdue</name>
        <label>Is Overdue?</label>
        <locationX>264</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Add_Open_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not overdue</defaultConnectorLabel>
        <rules>
            <name>Overdue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Each_Open_Task.ActivityDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Overdue_Task</targetReference>
            </connector>
            <label>Overdue</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Last_Engagement</name>
        <label>Has Last Engagement?</label>
        <locationX>176</locationX>
        <locationY>758</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Last_Engagement</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Last_Engagement</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>Agentforce action: returns a donor's open tasks (flagging overdue ones) and their most recent completed engagement, as agent-ready text plus counts.</description>
    <environments>Default</environments>
    <interviewLabel>Get Donor Engagements {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Donor Engagements</label>
    <loops>
        <name>Each_Open_Task</name>
        <label>Each Open Task</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <collectionReference>Get_Open_Tasks</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_Overdue</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Has_Last_Engagement</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Open_Tasks</name>
        <label>Get Open Tasks</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Last_Engagement</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhoId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>contactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Task</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>ActivityDate</queriedFields>
        <queriedFields>Priority</queriedFields>
        <sortField>ActivityDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Last_Engagement</name>
        <label>Get Last Engagement</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Each_Open_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhoId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>contactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>ActivityDate</queriedFields>
        <sortField>ActivityDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Open_Tasks</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <description>Summary so far plus one overdue task. The line break sits between the two parts because Flow trims trailing whitespace from text templates.</description>
        <name>SummaryPlusOverdueTask</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!openTasksSummary}
- OVERDUE (due {!Each_Open_Task.ActivityDate}): {!Each_Open_Task.Subject} [{!Each_Open_Task.Priority} priority]</text>
    </textTemplates>
    <textTemplates>
        <description>Summary so far plus one open task that is not overdue.</description>
        <name>SummaryPlusOpenTask</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!openTasksSummary}
- Due {!Each_Open_Task.ActivityDate}: {!Each_Open_Task.Subject} [{!Each_Open_Task.Priority} priority]</text>
    </textTemplates>
    <variables>
        <description>Salesforce ID of the donor Contact.</description>
        <name>contactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>One line per open task, overdue tasks first and marked OVERDUE. Blank when there are no open tasks.</description>
        <name>openTasksSummary</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Number of open tasks for the donor.</description>
        <name>openTaskCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <description>Number of open tasks whose due date has passed.</description>
        <name>overdueTaskCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <description>Subject of the most recent completed task (the last engagement). Blank if none.</description>
        <name>lastEngagementSubject</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Date of the most recent completed task. Blank if none.</description>
        <name>lastEngagementDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
